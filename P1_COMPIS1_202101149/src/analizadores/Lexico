LLAVE_C="}"
CONCAT="."
DISYUNCION="|"
KLEENE="*"
POSTIVA="+"
CBOOL="?"
PORCENTAJE="%"
PCOMA=";"
ESPACIO= [ \t\r\n]+
COMMENT_MULTILINE="<!" ([^!] | ("!" [^\>]))+ "!>"
COMMENT_SIMPLE="//".*
MINUSC= [a-z]
MAYUSC= [A-Z]
NUM = [0-9]
ESP = [ -/:@\[-`{-}]
ESCAPADOS = "\\\""|"\\\'"|"\\n"
NO_ESCAPADOS = [^\'\"]
ID = [a-zA-Z_][a-zA-Z0-9_]+
CHAR = (\" {NO_ESCAPADOS} \")|{ESCAPADOS}
STRING = \" ([^\"]|"\\\"")+ \"

